# --- Telegram ---
# Get from @BotFather
BOT_TOKEN=

# --- Railway ---
# Account Settings -> Tokens: https://railway.app/account/tokens
RAILWAY_API_TOKEN=
# Found in your project's Settings tab
RAILWAY_PROJECT_ID=
# Found in your project's Settings -> Environments tab (usually "production")
RAILWAY_ENVIRONMENT_ID=

# Docker images built from docker/xray and docker/ssh, pushed to a registry
# (Docker Hub, GHCR, etc). Railway pulls these when creating each new service.
XRAY_IMAGE=ghcr.io/yourname/xray-server:latest
SSH_IMAGE=ghcr.io/yourname/ssh-server:latest

# --- Cloudflare (optional) ---
# Only needed if you want servers fronted by your own domain instead of
# *.up.railway.app. Leave blank to skip this.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ROOT_DOMAIN=

# --- Misc ---
# How many days before an auto-provisioned server is deleted
SERVER_TTL_DAYS=30

# --- Telegram ---
BOT_TOKEN=

# Comma-separated Telegram user IDs who get admin access (panel + /grant)
ADMIN_TELEGRAM_IDS=123456789
# Your @username, shown to users when they request premium
ADMIN_CONTACT_USERNAME=yourusername

# --- Shared SSH server (docker/ssh-shared) ---
SSH_SHARED_INTERNAL_HOST=ssh-shared-server.railway.internal
SSH_API_SECRET=
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=

# --- Shared Xray server (docker/xray-shared) - serves VLESS + VMess ---
XRAY_SHARED_INTERNAL_HOST=xray-shared-server.railway.internal
XRAY_API_SECRET=
# Two separate Railway public domains, each pointing at a different
# internal port on the same xray-shared service:
#   XRAY_VLESS_PUBLIC_HOST -> targets port 8080
#   XRAY_VMESS_PUBLIC_HOST -> targets port 8081
XRAY_VLESS_PUBLIC_HOST=
XRAY_VMESS_PUBLIC_HOST=

# --- Plans ---
FREE_TRIAL_DAYS=1
